  "review_required": false,
  "vocabulary_spotlight": {
    "headword": "akwaaba",
    "gloss": "A warm welcome offered to a guest or newcomer.",
    "phonetic_bridge": {
      "pronunciation": "a-kwaa-ba"
    },
    "example_sentences": [
      "Akwaaba! Yɛma wo akwaaba.",
      "Akwaaba, bra mu."
    ],
    "culture_note": "Chale, greetings open every door in Ghana — never skip them before you ask for something. Reply to 'Wo ho te sɛn?' with a smooth 'Bɔkɔɔ' (chill / all good)."
  },
  "grammar_mechanics": {
    "focus": "Time-of-day greetings and their replies",
    "explanation": "Akan greetings change with the time of day: Maakye (morning), Maaha (afternoon), Maadwo (evening). A common reply adds 'Yaa' plus a term of respect, e.g. 'Yaa ɛna' to an elder woman.",
    "patterns": [
      "Maakye → Yaa ɛna / Yaa agya",
      "Wo ho te sɛn? → Me ho yɛ",
      "Medaase (thank you)"
    ]
  },
